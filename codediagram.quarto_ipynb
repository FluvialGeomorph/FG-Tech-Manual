        "Tool Reference Table\n",
        "\n",
        "library(tidyverse)\n",
        "library(knitr)\n",
        "library(kableExtra)\n",
        "\n",
        "tools <- tribble(\n",
        "  ~Phase, ~Tool, ~Package, ~Purpose, ~Inputs, ~Outputs, ~Dependencies, ~GitHub_Link,\n",
        "  \n",
        "  \"1\", \"FlowlinePoints\", \"fluvgeo\", \"Create analysis points along flowline\", \"Flowline, spacing\", \"Point feature class\", \"None\", \"https://github.com/FluvialGeomorph/fluvgeo/blob/master/R/FlowlinePoints.R\",\n",
        "  \"1\", \"ReachName\", \"fluvgeo\", \"Assign reach names\", \"Flowline points, breaks\", \"Points with reach names\", \"FlowlinePoints\", \"https://github.com/FluvialGeomorph/fluvgeo/blob/master/R/ReachName.R\",\n",
        "  \"1\", \"RegionalCurve\", \"RegionalCurve\", \"Estimate bankfull dimensions\", \"Drainage area\", \"Estimated dimensions\", \"Drainage area\", \"https://github.com/FluvialGeomorph/RegionalCurve/blob/master/R/RegionalCurve.R\",\n",
        "  \n",
        "  \"2\", \"XSCreateStationPoints\", \"fluvgeo\", \"Create XS points from survey\", \"Survey data\", \"XS point features\", \"Survey data\", \"https://github.com/FluvialGeomorph/fluvgeo/blob/master/R/XSCreateStationPoints.R\",\n",
        "  \"2\", \"XSAssignRiverPosition\", \"fluvgeo\", \"Assign river position\", \"XS points, bankfull\", \"Points with position\", \"XSCreateStationPoints\", \"https://github.com/FluvialGeomorph/fluvgeo/blob/master/R/XSAssignRiverPosition.R\",\n",
        "  \"2\", \"XSDimensions\", \"fluvgeo\", \"Calculate XS dimensions\", \"XS with position\", \"Width, depth, area\", \"XSAssignRiverPosition\", \"https://github.com/FluvialGeomorph/fluvgeo/blob/master/R/XSDimensions.R\",\n",
        "  \"2\", \"XSCompare\", \"fluvgeo\", \"Compare to regional\", \"XS dims, regional\", \"Comparison ratios\", \"XSDimensions, RegionalCurve\", \"https://github.com/FluvialGeomorph/fluvgeo/blob/master/R/XSCompare.R\",\n",
        "  \n",
        "  \"3\", \"LongitudinalProfile\", \"fluvgeo\", \"Extract elevation profile\", \"DEM, flowline\", \"Profile elevations\", \"FlowlinePoints\", \"https://github.com/FluvialGeomorph/fluvgeo/blob/master/R/LongitudinalProfile.R\",\n",
        "  \"3\", \"Slope\", \"fluvgeo\", \"Calculate slopes\", \"Profile elevations\", \"Reach/local slopes\", \"LongitudinalProfile\", \"https://github.com/FluvialGeomorph/fluvgeo/blob/master/R/Slope.R\",\n",
        "  \"3\", \"PoolRiffle\", \"fluvgeo\", \"Identify pool-riffle\", \"Profile, slope\", \"Feature locations\", \"Slope\", \"https://github.com/FluvialGeomorph/fluvgeo/blob/master/R/PoolRiffle.R\",\n",
        "  \n",
        "  \"4\", \"Sinuosity\", \"fluvgeo\", \"Calculate sinuosity\", \"Flowline, valley\", \"Sinuosity ratio\", \"FlowlinePoints\", \"https://github.com/FluvialGeomorph/fluvgeo/blob/master/R/Sinuosity.R\",\n",
        "  \"4\", \"Meander\", \"fluvgeo\", \"Analyze meanders\", \"Flowline\", \"Wavelength, amplitude\", \"Sinuosity\", \"https://github.com/FluvialGeomorph/fluvgeo/blob/master/R/Meander.R\",\n",
        "  \"4\", \"ValleyWidth\", \"fluvgeo\", \"Measure valley width\", \"Valley polygon\", \"Width, confinement\", \"XSDimensions\", \"https://github.com/FluvialGeomorph/fluvgeo/blob/master/R/ValleyWidth.R\",\n",
        "  \n",
        "  \"5\", \"RHGDimensions\", \"RHG\", \"Calculate hydraulic geometry\", \"XS at multiple flows\", \"RHG relations\", \"XSDimensions\", \"https://github.com/FluvialGeomorph/RHG/blob/master/R/RHGDimensions.R\",\n",
        "  \"5\", \"RHGCompare\", \"RHG\", \"Compare RHG to regional\", \"RHG, regional curves\", \"Departure metrics\", \"RHGDimensions, RegionalCurve\", \"https://github.com/FluvialGeomorph/RHG/blob/master/R/RHGCompare.R\",\n",
        "  \n",
        "  \"6\", \"ManningsN\", \"FluvialGeomorph\", \"Estimate roughness\", \"Bed, vegetation\", \"Manning's n\", \"Field observations\", \"https://github.com/FluvialGeomorph/FluvialGeomorph/blob/master/R/ManningsN.R\",\n",
        "  \"6\", \"Velocity\", \"FluvialGeomorph\", \"Calculate velocity\", \"n, R, slope\", \"Flow velocity\", \"ManningsN, Slope, XSDimensions\", \"https://github.com/FluvialGeomorph/FluvialGeomorph/blob/master/R/Velocity.R\",\n",
        "  \"6\", \"ShearStress\", \"FluvialGeomorph\", \"Calculate shear stress\", \"R, slope\", \"Boundary shear\", \"XSDimensions, Slope\", \"https://github.com/FluvialGeomorph/FluvialGeomorph/blob/master/R/ShearStress.R\",\n",
        "  \"6\", \"StreamPower\", \"FluvialGeomorph\", \"Calculate stream power\", \"Q, slope, width\", \"Unit/specific power\", \"Slope, XSDimensions\", \"https://github.com/FluvialGeomorph/FluvialGeomorph/blob/master/R/StreamPower.R\",\n",
        "  \n",
        "  \"7\", \"GrainSize\", \"FluvialGeomorph\", \"Analyze grain size\", \"Pebble count\", \"D16, D50, D84\", \"Field pebble count\", \"https://github.com/FluvialGeomorph/FluvialGeomorph/blob/master/R/GrainSize.R\",\n",
        "  \"7\", \"Shields\", \"FluvialGeomorph\", \"Calculate Shields parameter\", \"Shear, grain size\", \"Shields, critical τ\", \"ShearStress, GrainSize\", \"https://github.com/FluvialGeomorph/FluvialGeomorph/blob/master/R/Shields.R\",\n",
        "  \"7\", \"BedloadTransport\", \"FluvialGeomorph\", \"Calculate bedload\", \"Shields, grain size\", \"Transport rate\", \"Shields\", \"https://github.com/FluvialGeomorph/FluvialGeomorph/blob/master/R/BedloadTransport.R\",\n",
        "  \n",
        "  \"8\", \"StreamClassification\", \"FluvialGeomorph\", \"Classify stream type\", \"All metrics\", \"Stream type\", \"Multiple tools\", \"https://github.com/FluvialGeomorph/FluvialGeomorph/blob/master/R/StreamClassification.R\",\n",
        "  \"8\", \"XSVisualization\", \"fluvgeo\", \"Create XS plots\", \"XS data\", \"Plots\", \"XSDimensions\", \"https://github.com/FluvialGeomorph/fluvgeo/blob/master/R/XSVisualization.R\",\n",
        "  \"8\", \"ReportGeneration\", \"fluvgeo\", \"Generate reports\", \"All outputs\", \"HTML/PDF reports\", \"All tools\", \"https://github.com/FluvialGeomorph/fluvgeo/blob/master/R/ReportGeneration.R\"\n",
        ")\n",
        "\n",
        "tools %>%\n",
        "  mutate(\n",
        "    Tool = paste0('<a href=\"', GitHub_Link, '\" target=\"_blank\">', Tool, '</a>')\n",
        "  ) %>%\n",
        "  select(-GitHub_Link) %>%\n",
        "  kable(format = \"html\", escape = FALSE,\n",
        "        col.names = c(\"Phase\", \"Tool\", \"Package\", \"Purpose\", \"Inputs\", \"Outputs\", \"Dependencies\")) %>%\n",
        "  kable_styling(bootstrap_options = c(\"striped\", \"hover\", \"condensed\"),\n",
        "                full_width = TRUE,\n",
        "                font_size = 12) %>%\n",
        "  column_spec(1, bold = TRUE, width = \"4em\") %>%\n",
        "  column_spec(2, width = \"12em\") %>%\n",
        "  pack_rows(\"Phase 1: Data Preparation\", 1, 3, label_row_css = \"background-color: #E8F4F8;\") %>%\n",
        "  pack_rows(\"Phase 2: Cross Section\", 4, 7, label_row_css = \"background-color: #FFF4E6;\") %>%\n",
        "  pack_rows(\"Phase 3: Profile\", 8, 10, label_row_css = \"background-color: #E8F5E9;\") %>%\n",
        "  pack_rows(\"Phase 4: Planform\", 11, 13, label_row_css = \"background-color: #F3E5F5;\") %>%\n",
        "  pack_rows(\"Phase 5: Hydraulic Geometry\", 14, 15, label_row_css = \"background-color: #FCE4EC;\") %>%\n",
        "  pack_rows(\"Phase 6: Hydraulics\", 16, 19, label_row_css = \"background-color: #E3F2FD;\") %>%\n",
        "  pack_rows(\"Phase 7: Sediment\", 20, 22, label_row_css = \"background-color: #FFF3E0;\") %>%\n",
        "  pack_rows(\"Phase 8: Assessment\", 23, 25, label_row_css = \"background-color: #F1F8E9;\")\n",
        "Note: Tool names and links are based on typical FluvialGeomorph structure. Please verify actual function names in your repositories and update accordingly."
